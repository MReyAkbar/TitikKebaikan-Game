  m_Script: {fileID: 11500000, guid: 2b08ef5e8536dde4997b2932490e2894, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCFiguran
  npcName: Mbak Rara
  promptUI: {fileID: 1403627717}
  interactRadius: 1.1
  jelekDialogs:
  - Hati-hati di jalan ya, jangan sembarangan menyeberang.
  - Ayo bantu warga sekitar, Nak.
  lumayanDialogs:
  - Wah, kamu mulai dikenal suka membantu.
  - Teruskan ya, lingkungan jadi lebih rapi.
  bagusDialogs:
  - Kamu memang warga teladan!
  - Banyak warga terbantu karena kamu.
